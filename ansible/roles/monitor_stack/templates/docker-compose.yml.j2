# Managed by Ansible (monitor_stack role). Do not edit on the host.
services:
  uptime-kuma:
    image: {{ monitor_kuma_image }}
    container_name: uptime-kuma
    restart: unless-stopped
    ports:
      - "3001:3001"
    volumes:
      - uptime-kuma:/app/data

  ntfy:
    image: {{ monitor_ntfy_image }}
    container_name: ntfy
    restart: unless-stopped
    command: ["serve"]
    environment:
      - TZ={{ monitor_timezone }}
      - NTFY_BEHIND_PROXY=false
    ports:
      - "8080:80"
    volumes:
      - ntfy-cache:/var/cache/ntfy
      - ntfy-etc:/etc/ntfy

  # Public via the grafana.griffdawg.dev Caddy site (see monitor_sites).
  grafana:
    image: {{ monitor_grafana_image }}
    container_name: grafana
    restart: unless-stopped
    env_file:
      - .env
    environment:
      - GF_SERVER_ROOT_URL=https://{{ monitor_grafana_domain }}
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    depends_on:
      - loki

  # Tailnet-only (no Caddy site): Loki's push/query API has no built-in auth.
  # Bound to this droplet's own Tailscale IP so it's unreachable from the
  # public internet; Alloy on TrueNAS pushes here directly over Tailscale.
  loki:
    image: {{ monitor_loki_image }}
    container_name: loki
    restart: unless-stopped
    command: ["-config.file=/etc/loki/local-config.yaml"]
    ports:
      - "{{ monitor_tailscale_ip }}:{{ monitor_loki_port }}:3100"
    volumes:
      - ./loki/loki-config.yml:/etc/loki/local-config.yaml:ro
      - loki-data:/loki

  caddy:
    build:
      context: ./caddy
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    env_file:
      - .env
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      - uptime-kuma
      - grafana

volumes:
  uptime-kuma:
  ntfy-cache:
  ntfy-etc:
  grafana-data:
  loki-data:
  caddy-data:
  caddy-config:
