# Managed by Ansible (monitor_stack role). Do not edit on the host.
# Minimal single-binary Loki config: filesystem storage, TSDB index, 7-day
# retention. Loki is tailnet-only (see docker-compose.yml.j2) — no auth needed
# in front of it since it's not reachable from the public internet.
auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096

common:
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: 168h

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem
